    <button class="btn-audio-float" id="btnAudio" onclick="toggleSpeech()" title="ฟังเสียงต้อนรับ">
        <i class="fas fa-volume-up" id="iconAudio"></i>
    </button>

    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>
        AOS.init({ once: true, duration: 800 });

        function updateThaiTime() {
            const now = new Date();
            const thDays = ["อาทิตย์", "จันทร์", "อังคาร", "พุธ", "พฤหัสบดี", "ศุกร์", "เสาร์"];
            const thMonths = [
                "มกราคม", "กุมภาพันธ์", "มีนาคม", "เมษายน", "พฤษภาคม", "มิถุนายน",
                "กรกฎาคม", "สิงหาคม", "กันยายน", "ตุลาคม", "พฤศจิกายน", "ธันวาคม"
            ];

            const dayName = thDays[now.getDay()];
            const dayDate = now.getDate();
            const month = thMonths[now.getMonth()];
            const year = now.getFullYear() + 543;
            const hours = now.getHours().toString().padStart(2, '0');
            const minutes = now.getMinutes().toString().padStart(2, '0');
            const seconds = now.getSeconds().toString().padStart(2, '0');

            const timeString = `วัน${dayName}ที่ ${dayDate} ${month} ${year} | เวลา ${hours}:${minutes}:${seconds} น.`;
            document.getElementById('thaiTime').innerText = timeString;
        }

        updateThaiTime();
        setInterval(updateThaiTime, 1000);

        let isSpeaking = false;
        function toggleSpeech() {
            const synth = window.speechSynthesis;
            const btn = document.getElementById('btnAudio');
            const icon = document.getElementById('iconAudio');

            if (isSpeaking) {
                synth.cancel();
                isSpeaking = false;
                btn.classList.remove('speaking');
                icon.className = 'fas fa-volume-up';
            } else {
                const utter = new SpeechSynthesisUtterance("ยินดีต้อนรับสู่ จุกดี ก๋วยเตี๋ยวปากหม้อ สูตรโบราณ ตลาดบ้านใหม่ 100 ปี");
                utter.lang = 'th-TH';
                utter.onend = () => {
                    isSpeaking = false;
                    btn.classList.remove('speaking');
                    icon.className = 'fas fa-volume-up';
                };
                synth.speak(utter);
                isSpeaking = true;
                btn.classList.add('speaking');
                icon.className = 'fas fa-stop';
            }
        }
    </script>
</body>
</html>