<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>จุกดี ก๋วยเตี๋ยวปากหม้อ - ตลาดบ้านใหม่ 100 ปี</title>
    <meta name="description" content="ก๋วยเตี๋ยวปากหม้อสูตรโบราณ ตลาดบ้านใหม่ 100 ปี ฉะเชิงเทรา">
    
    <!-- Fonts & Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;600;700;900&family=Prompt:wght@400;600&family=Sarabun:wght@400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">

    <style>
        :root {
            --primary-red: #B22222;
            --gold-main: #D4AF37;
            --gold-light: #FFD700;
            --glass-bg: rgba(255, 255, 255, 0.96);
            --text-dark: #2c2c2c;
        }

        body {
            background-color: #f4f4f4;
            background-image: radial-gradient(#d1d1d1 1px, transparent 1px);
            background-size: 20px 20px;
            font-family: 'Kanit', 'Sarabun', 'Prompt', sans-serif;
            color: var(--text-dark);
            margin: 0;
            overflow-x: hidden;
        }

        /* --- Navigation --- */
        .navbar {
            position: fixed; top: 0; left: 0; width: 100%; 
            padding: 15px 20px; background: white; z-index: 1000;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
            display: flex; align-items: center; box-sizing: border-box;
        }
        .nav-brand { 
            font-weight: 700; color: var(--primary-red); font-size: 1.2rem; 
            text-decoration: none; display: flex; align-items: center; gap: 8px;
        }
        .nav-brand:hover { color: #800000; }

        /* --- Hero Section --- */
        .hero {
            width: 100%; height: 50vh; min-height: 400px;
            background: linear-gradient(to bottom, rgba(0,0,0,0.3), rgba(0,0,0,0.85)), 
                        url('https://www.jookdee100y.x10.bz/image/301565549_500683542065551_1327802872783650144_n.jpg');
            background-size: cover; background-position: center;
            display: flex; flex-direction: column; justify-content: center; align-items: center;
            text-align: center; color: white; border-bottom: 5px solid var(--gold-main);
            margin-top: 50px; padding: 0 20px; box-sizing: border-box;
        }
        .hero-title { font-size: clamp(2.5rem, 8vw, 4rem); font-weight: 900; margin: 0; color: var(--gold-light); text-shadow: 2px 2px 10px rgba(0,0,0,0.5); }
        .hero-subtitle { font-size: clamp(1.2rem, 4vw, 1.8rem); color: var(--gold-main); margin-top: 5px; margin-bottom: 15px; }
        
        /* --- ส่วนแสดงเวลา --- */
        .thai-time-badge {
            background: rgba(0, 0, 0, 0.6);
            border: 1px solid var(--gold-main);
            color: white;
            padding: 8px 20px;
            border-radius: 30px;
            font-size: 1rem;
            backdrop-filter: blur(5px);
            display: inline-flex;
            align-items: center;
            gap: 10px;
            margin-top: 10px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.3);
            animation: fadeIn 1s ease-in-out;
        }
        .thai-time-badge i { color: var(--gold-light); animation: pulse-clock 2s infinite; }
        
        @keyframes pulse-clock { 0% { opacity: 1; transform: scale(1); } 50% { opacity: 0.7; transform: scale(1.1); } 100% { opacity: 1; transform: scale(1); } }

        /* --- Quick Links Section (สไตล์ใหม่ประยุกต์เต็มรูปแบบ) --- */
        .quick-links-section {
            width: 100%; max-width: 1000px; margin: -40px auto 30px auto;
            position: relative; z-index: 10; padding: 0 15px; box-sizing: border-box;
        }
        
        .ql-outer-box {
            width: 100%;
            padding: 35px;
            background: linear-gradient(145deg, #ffffff, #f0f2f5);
            border-radius: 30px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.08);
            box-sizing: border-box;
        }

        .quick-link-container {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
            gap: 24px;
            justify-content: center;
        }

        .q-group-title {
            grid-column: 1 / -1;
            display: flex;
            align-items: center;
            font-size: 1.35rem;
            font-weight: 700;
            color: #2c3e50;
            margin: 25px 0 10px 0;
            padding: 12px 18px;
            border-left: 6px solid #D4AF37;
            background: linear-gradient(90deg, rgba(212, 175, 55, 0.12), transparent);
            border-radius: 0 12px 12px 0;
            letter-spacing: 0.5px;
        }

        .q-group-title:first-child { margin-top: 0; }
        .q-group-title i { margin-right: 12px; color: #B22222; }

        .q-link {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 28px 20px;
            background: #ffffff;
            border: 1px solid rgba(0,0,0,0.04);
            border-radius: 20px;
            text-decoration: none;
            color: #444444;
            font-weight: 600;
            font-size: 1rem;
            line-height: 1.5;
            letter-spacing: 0.3px;
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            box-shadow: 0 6px 18px rgba(0,0,0,0.04);
            position: relative;
            text-align: center;
            min-height: 140px;
            box-sizing: border-box;
        }

        .q-link i {
            font-size: 2.6rem;
            margin-bottom: 16px;
            background: linear-gradient(45deg, #B22222, #FF4500);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            transition: transform 0.4s ease;
            filter: drop-shadow(0 3px 6px rgba(178, 34, 34, 0.25));
        }

        .q-link span { display: block; margin-top: 4px; }
        .q-link small { display: block; margin-top: 6px; font-size: 0.85rem; font-weight: 400; opacity: 0.85; }

        .q-link:hover {
            transform: translateY(-8px);
            box-shadow: 0 16px 32px rgba(0,0,0,0.12);
            border-color: rgba(0,0,0,0);
        }

        .q-link:hover i { transform: scale(1.15) rotate(-4deg); }

        .q-link.yt-style:hover { border-bottom: 4px solid #FF0000; }
        .q-link.yt-style i { 
            background: linear-gradient(45deg, #FF0000, #cc0000); 
            -webkit-background-clip: text; -webkit-text-fill-color: transparent; 
            filter: drop-shadow(0 3px 6px rgba(255, 0, 0, 0.3));
        }

        .q-link.fb-style:hover { border-bottom: 4px solid #1877F2; }
        .q-link.fb-style i { 
            background: linear-gradient(45deg, #1877F2, #0056b3); 
            -webkit-background-clip: text; -webkit-text-fill-color: transparent; 
            filter: drop-shadow(0 3px 6px rgba(24, 119, 242, 0.3));
        }

        .q-link.web-style:hover { border-bottom: 4px solid #28a745; }
        .q-link.web-style i { 
            background: linear-gradient(45deg, #28a745, #20c997); 
            -webkit-background-clip: text; -webkit-text-fill-color: transparent; 
            filter: drop-shadow(0 3px 6px rgba(40, 167, 69, 0.3));
        }

        /* --- Content & Gallery --- */
        .container-content { width: 100%; max-width: 600px; margin: 0 auto; padding: 0 15px; box-sizing: border-box; }
        .glass-card {
            background: var(--glass-bg); border-radius: 20px; padding: 25px 20px; margin-bottom: 30px;
            text-align: center; border: 2px solid white; outline: 3px solid var(--gold-main);
            outline-offset: -8px; box-shadow: 0 15px 30px rgba(0,0,0,0.1);
        }
        .section-header {
            display: inline-flex; align-items: center; gap: 10px; background: white; padding: 8px 20px;
            border-radius: 50px; box-shadow: 0 3px 6px rgba(0,0,0,0.1); font-weight: 800;
            color: var(--primary-red); margin-bottom: 20px;
        }
        .gallery-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; margin-bottom: 20px; }
        .gallery-item { aspect-ratio: 1/1; overflow: hidden; border-radius: 12px; border: 2px solid var(--gold-main); }
        .gallery-item img { width: 100%; height: 100%; object-fit: cover; }
        
        .btn-main {
            display: block; width: 100%; padding: 15px; border-radius: 12px;
            background: linear-gradient(to bottom, #ff4d4d, #b30000); color: white;
            text-decoration: none; font-weight: 700; font-size: 1.1rem; box-shadow: 0 5px 0 #800000;
            transition: transform 0.2s; box-sizing: border-box;
        }
        .btn-main:active { transform: translateY(3px); box-shadow: 0 2px 0 #800000; }

        /* --- Footer --- */
        .footer-premium {
            background: linear-gradient(to bottom, #2b0a0a, #000000); color: white;
            padding: 40px 20px; text-align: center; margin-top: 50px;
        }
        .footer-line { width: 50%; max-width: 200px; height: 1px; background: rgba(255,255,255,0.2); border: 0; margin: 20px auto; }

        /* --- Audio Button --- */
        .btn-audio-float {
            position: fixed; bottom: 20px; right: 20px; width: 55px; height: 55px;
            border-radius: 50%; border: none; background: var(--gold-main); color: #333;
            cursor: pointer; z-index: 9999; box-shadow: 0 4px 15px rgba(0,0,0,0.3);
            display: flex; align-items: center; justify-content: center; font-size: 1.3rem;
        }
        .btn-audio-float.speaking { background: #ff4444; color: white; animation: pulse 1.5s infinite; }

        @keyframes pulse { 0% { transform: scale(1); } 50% { transform: scale(1.1); } 100% { transform: scale(1); } }

        @media (max-width: 768px) {
            .ql-outer-box { padding: 20px 15px; margin: 15px auto; width: 100%; }
            .quick-link-container { grid-template-columns: repeat(2, 1fr); gap: 14px; }
            .q-link { padding: 20px 10px; min-height: 120px; font-size: 0.95rem; }
            .q-link i { font-size: 2.2rem; margin-bottom: 10px; }
            .q-group-title { font-size: 1.15rem; padding: 10px 14px; margin: 15px 0 5px 0; }
            .hero { height: 40vh; }
        }
    </style>
</head>
